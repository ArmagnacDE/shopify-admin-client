{
  "name": "shopify-admin-client",
  "version": "1.2.0",
  "description": "Schlanker, dependency-freier Shopify Admin GraphQL-Client (Client-Credentials-Grant, Token-Caching, Retry + Rate-Limit-Handling) mit Multi-Store-Registry und Live-Identitaetspruefung.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./registry": "./store-registry.js",
    "./guard": "./mutation-guard.js"
  },
  "files": [
    "index.js",
    "transport.js",
    "errors.js",
    "identity.js",
    "store-registry.js",
    "mutation-guard.js",
    "jsonl-audit.js",
    "boundary.js",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test \"test/*.test.mjs\"",
    "test:install": "node scripts/test-install.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT"
}
